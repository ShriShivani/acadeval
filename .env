VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=false
# ── Database ──────────────────────────────────────────────────────────────────
# Local uvicorn: use localhost
# Docker Compose: change back to @db:5432
DATABASE_URL=postgresql://acadeval:acadeval_secret@localhost:5432/acadeval

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=acadeval_super_secret_jwt_key_change_in_production_32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── AI / External APIs ────────────────────────────────────────────────────────
GEMINI_API_KEY=
SEMANTIC_SCHOLAR_KEY=
# Optional: GitHub personal access token — raises rate limit from 60 to 5000 req/hr
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ── Moodle LMS Integration (Module 13) ───────────────────────────────────────
# Leave blank if you are not using Moodle — the sync task will skip gracefully.
# How to get a token: Moodle → Site Admin → Plugins → Web Services → Manage tokens
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_ASSIGNMENT_ID=0
# AcadEval faculty user UUID to use as the uploader for Moodle-imported projects
# Find it in: SELECT id FROM users WHERE role='hod' LIMIT 1;
MOODLE_FACULTY_USER_ID=

# ── Module 14: Gmail SMTP Notification Service ──────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=acadeval221@gmail.com
SMTP_PASSWORD=kymh spjy dyih dqqs
SMTP_FROM_NAME=AcadEval+ Platform


# ── Neo4j (AcadEval+ graph engine) ────────────────────────────────────────────
# Local Docker: run docker compose up -d neo4j from the project root
# Neo4j Browser UI available at: http://localhost:7474  (neo4j / acadeval_password)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=acadeval_password
NEO4J_DATABASE=


# ── Redis / Celery ────────────────────────────────────────────────────────────
# Local: use localhost | Docker: use redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173